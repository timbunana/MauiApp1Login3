<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1Login3.Entrada"
             Title="Entrada">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label 
            Text="Escolha uma opção de Atuação:"
            FontAttributes="Bold"
            FontSize="18"
            HorizontalOptions="Center" />

        <Picker x:Name="AtuacaoPicker"
                Title="Selecione uma opção..."
                SelectedIndexChanged="OnAtuacaoChanged"
                HorizontalOptions="Fill">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Telecomunicações</x:String>
                    <x:String>Elétrica Predial</x:String>
                    <x:String>Análise de Frota</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <Label x:Name="ResultadoLabel"
               FontSize="14"
               FontAttributes="Italic"
               HorizontalOptions="Center"
               TextColor="Gray" />

        <!-- Botão para confirmar e navegar -->
        <Button x:Name="AvancarBtn"
                Text="Continuar"
                Clicked="OnAvancarClicked"
                Margin="0,20,0,0" />

    </VerticalStackLayout>
</ContentPage>