<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1Login3.Dialogo"
             IsVisible="False"
             InputTransparent="False">

    <Grid BackgroundColor="{StaticResource Scrim}">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnVeuTocado" />
        </Grid.GestureRecognizers>

        <Border Style="{StaticResource Card}"
                VerticalOptions="End"
                Margin="16,16,16,20">
            <VerticalStackLayout Spacing="18">
                <Label x:Name="TituloLabel" Style="{StaticResource EyebrowText}" />
                <Label x:Name="MensagemLabel" Style="{StaticResource BodyText}" />
                <VerticalStackLayout x:Name="Opcoes" Spacing="10" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
