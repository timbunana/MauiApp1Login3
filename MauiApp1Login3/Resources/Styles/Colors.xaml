<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta do design system (ver DESIGN.md). App é somente tema escuro.
         Dark premium: preto profundo levemente quente + dourado champanhe. -->

    <!-- Superfícies -->
    <Color x:Key="Surface">#0A0908</Color>
    <Color x:Key="SurfaceCard">#131110</Color>
    <Color x:Key="SurfaceChip">#1C1917</Color>
    <Color x:Key="BorderSubtle">#2A2522</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimary">#F7F5F2</Color>
    <Color x:Key="TextSecondary">#A09890</Color>

    <!-- Acento: dourado champanhe -->
    <Color x:Key="Accent">#D4A862</Color>
    <Color x:Key="AccentStrong">#E0BC83</Color>
    <Color x:Key="OnAccent">#1A1409</Color>

    <!-- Véu atrás do diálogo -->
    <Color x:Key="Scrim">#D90A0908</Color>

    <!-- Estado de segurança -->
    <Color x:Key="Success">#4CAF7D</Color>
    <Color x:Key="Danger">#D9646A</Color>

</ResourceDictionary>
