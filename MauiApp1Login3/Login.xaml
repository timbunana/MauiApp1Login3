<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiApp1Login3"
             x:Class="MauiApp1Login3.Login"
             Shell.NavBarIsVisible="False">

  <Grid>
    <!-- Sem ScrollView: a tela inteira cabe sem rolagem. -->
    <Grid RowDefinitions="*, Auto" Padding="24,24,24,20" RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" Spacing="18" VerticalOptions="Start">

            <!-- Marca, para a tela não começar direto no formulário -->
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                <Border Style="{StaticResource IconChip}" WidthRequest="38" HeightRequest="38">
                    <Image Source="ic_shield.png"
                           WidthRequest="19" HeightRequest="19"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1"
                       Text="CampoSeguro"
                       Style="{StaticResource TitleText}"
                       FontSize="17"
                       VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="6">
                <Label Text="ACESSO" Style="{StaticResource EyebrowText}" />
                <Label Text="Bem-vindo de volta."
                       Style="{StaticResource HeadlineText}"
                       FontSize="24" />
                <Label Text="Entre para registrar a análise preliminar de risco."
                       Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>

            <!-- Formulário agrupado em card, para ganhar peso na tela -->
            <Border Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="USUÁRIO" Style="{StaticResource EyebrowText}" />
                        <Border Style="{StaticResource FormField}" Padding="14,2">
                            <Entry x:Name="txtUsuario"
                                   Placeholder="Seu usuário"
                                   HeightRequest="44"
                                   ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="SENHA" Style="{StaticResource EyebrowText}" />
                        <Border Style="{StaticResource FormField}" Padding="14,2">
                            <Entry x:Name="txtSenha"
                                   Placeholder="Sua senha"
                                   IsPassword="True"
                                   HeightRequest="44"
                                   ReturnType="Done"
                                   Completed="Button_Clicked" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="Esqueci minha senha"
                           Style="{StaticResource SecondaryText}"
                           FontSize="14"
                           TextColor="{StaticResource Accent}"
                           HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEsqueciSenhaTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="14">

            <Button Text="Entrar  →"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="50"
                    Clicked="Button_Clicked" />

            <BoxView Style="{StaticResource Separator}" />

            <Label Text="Acesso restrito às equipes autorizadas."
                   Style="{StaticResource SecondaryText}"
                   FontSize="13"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>

    </Grid>

    <local:Dialogo x:Name="Dialogo" />
  </Grid>

</ContentPage>
