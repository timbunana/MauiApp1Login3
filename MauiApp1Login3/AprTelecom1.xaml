<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1Login3.AprTelecom1"
             Title="APR Telecomunicações">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label 
                Text="Análise Preliminar de Risco (APR)"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,0,0,10" />

            <!-- 10 Opções (Switch) -->
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="1. Uso de Capacete com Jugular" VerticalOptions="Center" FontSize="15" />
                <Switch x:Name="Opcao1Switch" Grid.Column="1" IsToggled="False" />
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <Label Text="2. Cinto Tipo Paraquedista e Talabarte" VerticalOptions="Center" FontSize="15" />
                <Switch x:Name="Opcao2Switch" Grid.Column="1" IsToggled="False" />
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <Label Text="3. Luvas de Proteção Adequadas" VerticalOptions="Center" FontSize="15" />
                <Switch x:Name="Opcao3Switch" Grid.Column="1" IsToggled="False" />
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <Label Text="4. Bota de Segurança com Biqueira" VerticalOptions="Center" FontSize="15" />
                <Switch x:Name="Opcao4Switch" Grid.Column="1" IsToggled="False" />
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <Label Text="5. Óculos de Proteção" VerticalOptions="Center" FontSize="15" />
                <Switch x:Name="Opcao5Switch" Grid.Column="1" IsToggled="False" />
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <Label Text="6. Sinalização de Segurança na Área" VerticalOptions="Center" FontSize="15" />
                <Switch x:Name="Opcao6Switch" Grid.Column="1" IsToggled="False" />
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <Label Text="7. Escada Inspecionada e Amarrada" VerticalOptions="Center" FontSize="15" />
                <Switch x:Name="Opcao7Switch" Grid.Column="1" IsToggled="False" />
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <Label Text="8. Ferramentas Isoladas/Em Bom Estado" VerticalOptions="Center" FontSize="15" />
                <Switch x:Name="Opcao8Switch" Grid.Column="1" IsToggled="False" />
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <Label Text="9. Ausência de Cabos Elétricos Desencapados" VerticalOptions="Center" FontSize="15" />
                <Switch x:Name="Opcao9Switch" Grid.Column="1" IsToggled="False" />
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <Label Text="10. Condições Climáticas Favoráveis" VerticalOptions="Center" FontSize="15" />
                <Switch x:Name="Opcao10Switch" Grid.Column="1" IsToggled="False" />
            </Grid>

            <Line X2="300" Stroke="Gray" HorizontalOptions="Center" Margin="0,10" />

            <!-- Botão de Tirar Foto -->
            <Button 
                Text="📷 Capturar Evidência (Tirar Foto)" 
                BackgroundColor="#2196F3"
                TextColor="White"
                Clicked="OnTirarFotoClicked" />

            <!-- Botão para sair -->
            <Button
                Text="Sair"
                BackgroundColor="#f44336"
                TextColor="White"
                Clicked="OnSairClicked" />

            <!-- Imagem para exibir o resultado da foto -->
            <Image 
                x:Name="FotoEvidenciaImage"
                HeightRequest="200"
                Aspect="AspectFit"
                IsVisible="False"
                HorizontalOptions="Center" />

            <!-- Botão de Salvar -->
            <Button 
                Text="Salvar APR" 
                BackgroundColor="#4CAF50"
                TextColor="White"
                Margin="0,20,0,0"
                Clicked="OnSalvarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>