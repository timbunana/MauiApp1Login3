<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CampoSeguro"
             x:Class="CampoSeguro.MainPage"
             Shell.NavBarIsVisible="False">

  <Grid>
    <!-- Sem ScrollView: a abertura cabe inteira na tela. -->
    <Grid RowDefinitions="Auto, *, Auto" Padding="20,20,20,24" RowSpacing="20">

        <!-- Cabeçalho flutuante: marca à esquerda, ação à direita -->
        <Border Grid.Row="0" Style="{StaticResource FloatingBar}" Padding="14,8">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                <Border Grid.Column="0"
                        Style="{StaticResource IconChip}"
                        WidthRequest="36"
                        HeightRequest="36">
                    <Image Source="ic_shield.png"
                           WidthRequest="18"
                           HeightRequest="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Grid.Column="1"
                       Text="CampoSeguro"
                       Style="{StaticResource TitleText}"
                       FontSize="17"
                       VerticalOptions="Center" />

                <Button Grid.Column="2"
                        Text="Entrar"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="36"
                        CornerRadius="18"
                        FontSize="13"
                        Padding="16,0"
                        Clicked="EntrarClicked" />
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1" Spacing="16" VerticalOptions="Center" Padding="4,0">

            <Border Style="{StaticResource BadgePill}" Padding="14,6">
                <Label Text="SEGURANÇA EM PRIMEIRO LUGAR"
                       Style="{StaticResource EyebrowText}"
                       FontSize="11" />
            </Border>

            <VerticalStackLayout Spacing="0">
                <Label Text="Seu campo."
                       Style="{StaticResource DisplayText}"
                       FontSize="32" />
                <Label Text="Sua análise"
                       Style="{StaticResource AccentDisplayText}"
                       FontSize="32" />
                <Label Text="de risco."
                       Style="{StaticResource AccentDisplayText}"
                       FontSize="32" />
            </VerticalStackLayout>

            <Label Text="Checklist de EPI, evidência em foto e relatório pronto para enviar."
                   Style="{StaticResource SecondaryText}" />

        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Button Text="Iniciar uma APR  →"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="50"
                    SemanticProperties.Hint="Abre a tela de login"
                    Clicked="EntrarClicked" />

            <Button Text="Como funciona"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="48"
                    Clicked="ComoFuncionaClicked" />
        </VerticalStackLayout>

    </Grid>

    <local:Dialogo x:Name="Dialogo" />
  </Grid>

</ContentPage>
