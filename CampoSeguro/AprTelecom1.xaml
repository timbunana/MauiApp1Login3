<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CampoSeguro"
             x:Class="CampoSeguro.AprTelecom1"
             Shell.NavBarIsVisible="False">

  <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="24,32,24,28" Spacing="20">

            <VerticalStackLayout Spacing="8">
                <Label Text="TELECOMUNICAÇÕES" Style="{StaticResource EyebrowText}" />
                <Label Text="Análise preliminar de risco."
                       Style="{StaticResource HeadlineText}"
                       FontSize="24" />
            </VerticalStackLayout>

            <!-- Tipo de trabalho: era um ActionSheet do sistema, agora é parte da tela. -->
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Border Style="{StaticResource IconChip}" WidthRequest="42" HeightRequest="42">
                        <Image Source="ic_shield.png"
                               WidthRequest="20" HeightRequest="20"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Como é a atividade?" Style="{StaticResource TitleText}" />
                        <Label Text="A escolha define quais itens precisam ser conferidos."
                               Style="{StaticResource SecondaryText}" />
                    </VerticalStackLayout>

                    <Button x:Name="BtnMesmoNivel"
                            Text="No mesmo nível"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="48"
                            Clicked="OnMesmoNivelClicked" />

                    <Button x:Name="BtnAltura"
                            Text="Em altura"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="48"
                            Clicked="OnAlturaClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Checklist. Os itens vêm de CatalogoEpis, em AprTelecom1.xaml.cs. -->
            <Border x:Name="ChecklistCard" Style="{StaticResource Card}" Padding="20" IsVisible="False">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Itens de verificação" Style="{StaticResource TitleText}" />
                        <Label x:Name="SubtituloLabel" Style="{StaticResource SecondaryText}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ListaEpis" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ItemEpi">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16" Padding="0,12">
                                    <Label Text="{Binding Rotulo}"
                                           Style="{StaticResource BodyText}"
                                           FontSize="15"
                                           VerticalOptions="Center" />
                                    <Switch Grid.Column="1"
                                            IsToggled="{Binding Marcado, Mode=TwoWay}"
                                            VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Identificação: era um DisplayPrompt na hora de salvar. -->
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Identificação" Style="{StaticResource TitleText}" />
                        <Label Text="Nome de quem está assinando a APR."
                               Style="{StaticResource SecondaryText}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource FormField}" Padding="16,2">
                        <Entry x:Name="txtNome"
                               Placeholder="Seu nome completo"
                               HeightRequest="44" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Evidência fotográfica -->
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Border Style="{StaticResource IconChip}" WidthRequest="42" HeightRequest="42">
                        <Image Source="ic_camera.png"
                               WidthRequest="20" HeightRequest="20"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Evidência" Style="{StaticResource TitleText}" />
                        <Label Text="Uma foto do local reforça o registro."
                               Style="{StaticResource SecondaryText}" />
                    </VerticalStackLayout>

                    <Border x:Name="FotoBorder" IsVisible="False"
                            Stroke="Transparent" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Image x:Name="FotoEvidenciaImage"
                               Aspect="AspectFill"
                               HeightRequest="170" />
                    </Border>

                    <Button x:Name="FotoBtn"
                            Text="Capturar evidência"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="48"
                            Clicked="OnTirarFotoClicked" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Button Text="Salvar e compartilhar  →"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="50"
                        Clicked="OnSalvarClicked" />

                <Button Text="Sair"
                        Style="{StaticResource DangerButton}"
                        HeightRequest="48"
                        Clicked="OnSairClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

    <local:Dialogo x:Name="Dialogo" />
  </Grid>

</ContentPage>
