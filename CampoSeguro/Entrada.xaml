<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CampoSeguro"
             x:Class="CampoSeguro.Entrada"
             Shell.NavBarIsVisible="False">

  <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,32" Spacing="32">

            <VerticalStackLayout Spacing="12">
                <Label Text="ONDE VOCÊ ATUA" Style="{StaticResource EyebrowText}" />
                <Label Text="Escolha a operação."
                       Style="{StaticResource HeadlineText}" />
                <Label Text="Cada área tem o seu próprio checklist de risco."
                       Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="16">

                <Border Style="{StaticResource Card}"
                        SemanticProperties.Description="Telecomunicações. Abrir checklist de APR."
                        SemanticProperties.Hint="Toque para abrir">
                    <!-- O gesto fica no Grid, não no Border: só um elemento com fundo próprio
                         recebe o toque em toda a área do card. -->
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTelecomTapped" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="16">
                            <Border Style="{StaticResource IconChip}">
                                <Image Source="ic_tower.png"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Telecomunicações" Style="{StaticResource TitleText}" />
                                <Label Text="Torres, antenas, fibra e rede externa"
                                       Style="{StaticResource SecondaryText}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" Style="{StaticResource ChevronText}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}"
                        SemanticProperties.Description="Elétrica Predial. Módulo em breve, indisponível.">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEmBreveTapped" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="16">
                            <Border Style="{StaticResource IconChip}">
                                <Image Source="ic_bolt.png"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Elétrica Predial"
                                       Style="{StaticResource TitleText}"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Text="Quadros, instalações e manutenção"
                                       Style="{StaticResource SecondaryText}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="EM BREVE"
                               Style="{StaticResource EyebrowText}"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}"
                        SemanticProperties.Description="Análise de Frota. Módulo em breve, indisponível.">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEmBreveTapped" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="16">
                            <Border Style="{StaticResource IconChip}">
                                <Image Source="ic_truck.png"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Análise de Frota"
                                       Style="{StaticResource TitleText}"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Text="Veículos, equipamentos e deslocamento"
                                       Style="{StaticResource SecondaryText}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="EM BREVE"
                               Style="{StaticResource EyebrowText}"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

    <local:Dialogo x:Name="Dialogo" />
  </Grid>

</ContentPage>
